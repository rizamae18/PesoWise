<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Space android:layout_width="match_parent" android:layout_height="40dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_account"
            android:textColor="@color/text_white"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/register_tagline"
            android:textColor="@color/text_light_gray"
            android:textSize="14sp"
            android:gravity="center"/>

        <Space android:layout_width="match_parent" android:layout_height="36dp"/>

        <!-- Email field -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/email"
            android:hintTextColor="@color/text_hint"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:inputType="textEmailAddress"
            android:singleLine="true"/>

        <Space android:layout_width="match_parent" android:layout_height="14dp"/>

        <!-- Username field -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/username"
            android:hintTextColor="@color/text_hint"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:inputType="text"
            android:singleLine="true"/>

        <Space android:layout_width="match_parent" android:layout_height="14dp"/>

        <!-- Password field -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/password"
            android:hintTextColor="@color/text_hint"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:inputType="textPassword"
            android:singleLine="true"/>

        <Space android:layout_width="match_parent" android:layout_height="14dp"/>

        <!-- Re-enter Password field -->
        <EditText
            android:id="@+id/etRePassword"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/re_enter_password"
            android:hintTextColor="@color/text_hint"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:inputType="textPassword"
            android:singleLine="true"/>

        <Space android:layout_width="match_parent" android:layout_height="12dp"/>

        <!-- Terms -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terms_text"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <Space android:layout_width="match_parent" android:layout_height="16dp"/>

        <!-- Sign Up Button -->
        <Button
            android:id="@+id/btnSignUp"
            android:layout_width="200dp"
            android:layout_height="54dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_green_button"
            android:text="@string/sign_up"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"/>

        <Space android:layout_width="match_parent" android:layout_height="16dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

        <Space android:layout_width="match_parent" android:layout_height="16dp"/>

        <!-- Login link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_account"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Log In"
                android:textColor="@color/blue_link"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="40dp"/>

    </LinearLayout>
</ScrollView>