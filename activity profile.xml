<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="28dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/text_white"
                android:clickable="true"
                android:focusable="true"/>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="@color/text_white"
                android:layout_marginStart="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Admin"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginStart="10dp"/>

            <ImageView
                android:id="@+id/btnEdit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="@color/text_white"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/itemSettings"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_menu_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings" android:textColor="@color/text_dark" android:textSize="17sp"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/arrow_up_float" android:rotation="90" android:tint="@color/text_dark"/>
        </LinearLayout>

        <!-- Notification -->
        <LinearLayout
            android:id="@+id/itemNotification"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_menu_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/notification" android:textColor="@color/text_dark" android:textSize="17sp"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/arrow_up_float" android:rotation="90" android:tint="@color/text_dark"/>
        </LinearLayout>

        <!-- Community Rules -->
        <LinearLayout
            android:id="@+id/itemCommunityRules"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_menu_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/community_rules" android:textColor="@color/text_dark" android:textSize="17sp"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/arrow_up_float" android:rotation="90" android:tint="@color/text_dark"/>
        </LinearLayout>

        <!-- Help -->
        <LinearLayout
            android:id="@+id/itemHelp"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_menu_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/help" android:textColor="@color/text_dark" android:textSize="17sp"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/arrow_up_float" android:rotation="90" android:tint="@color/text_dark"/>
        </LinearLayout>

        <!-- Logout -->
        <LinearLayout
            android:id="@+id/itemLogout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_menu_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/logout" android:textColor="@color/text_dark" android:textSize="17sp"/>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/arrow_up_float" android:rotation="90" android:tint="@color/text_dark"/>
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="24dp"/>

    </LinearLayout>
</ScrollView>